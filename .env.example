# Konfiguration fuer den docker-compose-Stack (Server).
# Auf dem Server nach `.env` kopieren und echte Werte setzen.
# NICHT committen — `.env` ist in .gitignore und wird vom Deploy NICHT ueberschrieben.

# Postgres-Passwort (lange Zufallszeichenkette). Wird von postgres UND app genutzt.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Credit-Modell (verkaufte Keys) ---------------------------------------
# Verkaufte API-Keys, komma- oder leerzeichengetrennt (max. 100). Sobald hier
# mind. ein Key steht, ist die API abgesichert: jeder Aufruf von /validate und
# /generate braucht einen gueltigen X-API-Key. Jeder Key erlaubt CREDITS_PER_KEY
# Abfragen; der Verbrauch wird gezaehlt (Anzeige auf /playground: x/120).
# Lange Zufallswerte verwenden, z.B. `openssl rand -hex 16` pro Key.
API_KEYS=
# Credits (Abfragen) pro Key.
CREDITS_PER_KEY=120

# Oeffentliche Test-Seite /playground: anonymes Limit pro Client-IP (ohne Key).
PLAYGROUND_RATE_PER_MIN=30
