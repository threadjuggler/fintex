# Konfiguration fuer den docker-compose-Stack (Server).
# Auf dem Server nach `.env` kopieren und echte Werte setzen.
# NICHT committen — `.env` ist in .gitignore und wird vom Deploy NICHT ueberschrieben.

# Postgres-Passwort (lange Zufallszeichenkette). Wird von postgres UND app genutzt.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Initialer API-Key, der beim Start angelegt wird (Pilot-Key). Leer lassen = keiner.
BOOTSTRAP_API_KEY=change-me-initial-pilot-key

# Optionales Rate-Limit pro API-Key und Minute.
RATE_LIMIT_PER_MIN=120
